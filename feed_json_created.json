_published": "2026-04-30T00:00:00+00:00", "authors": [{"name": "Cloaks"}], "tags": ["\u5206\u6b65\u6b62\u76c8", "\u7092\u80a1\u517b\u5bb6", "\u7b56\u7565\u5207\u6362", "\u7f51\u683c\u4ea4\u6613", "\u8d8b\u52bf\u8ddf\u8e2a", "\u91cf\u5316\u7b56\u7565", "\u98ce\u9669\u7ba1\u7406"]}, {"id": "https://cloaks.cn/blog/posts/2026/04/15/", "url": "https://cloaks.cn/blog/posts/2026/04/15/", "title": "AI Prompt \u5de5\u5177\u7bb1\uff1a\u4e0d\u540c\u573a\u666f\u4e0b\u7684\u5b9e\u7528\u63d0\u793a\u8bcd", "content_html": "\u8bb0\u5f55\u65e5\u5e38\u5f00\u53d1\u4e2d\u5404\u7c7b\u573a\u666f\u4e0b\u5b9e\u7528\u7684 AI Prompt\uff0c\u6db5\u76d6 Git \u5de5\u4f5c\u6d41\u3001\u4ee3\u7801\u5ba1\u67e5\u3001\u535a\u5ba2\u5199\u4f5c\u3001\u6027\u80fd\u5206\u6790\u7b49\uff0c\u6301\u7eed\u66f4\u65b0\u3002", "image": "https://cloaks.cn/assets/images/social/blog/posts/2026/04/15.png", "date_modified": "2026-09-09T09:25:33+00:00", "date_published": "2026-04-15T00:00:00+00:00", "authors": [{"name": "Cloaks"}], "tags": ["AI", "CodeBuddy", "Prompt", "\u5de5\u5177", "\u5de5\u7a0b\u5b9e\u8df5"]}, {"id": "https://cloaks.cn/blog/posts/2026/03/23/", "url": "https://cloaks.cn/blog/posts/2026/03/23/", "title": "Go \u4f18\u96c5\u9000\u51fa\u5b8c\u5168\u6307\u5357\uff1asignal.NotifyContext \u5b9e\u6218", "content_html": "\u6df1\u5165\u89e3\u6790 Go \u8bed\u8a00\u4e2d\u5229\u7528 signal.NotifyContext \u5b9e\u73b0\u4f18\u96c5\u9000\u51fa\u7684\u6807\u51c6\u5b9e\u8df5\uff0c\u6db5\u76d6 HTTP \u670d\u52a1\u5668\u3001\u6279\u91cf\u4efb\u52a1\u3001\u5e26\u6e05\u7406\u7684\u957f\u65f6\u95f4\u8fd0\u884c\u4efb\u52a1\u7b49\u5178\u578b\u573a\u666f\u3002", "image": "https://cloaks.cn/assets/images/social/blog/posts/2026/03/23.png", "date_modified": "2026-09-09T09:25:33+00:00", "date_published": "2026-03-23T00:00:00+00:00", "authors": [{"name": "Cloaks"}], "tags": ["Go", "Go", "\u5de5\u7a0b\u5b9e\u8df5", "\u8fdb\u7a0b\u7ba1\u7406"]}, {"id": "https://cloaks.cn/blog/posts/2026/03/19-2/", "url": "https://cloaks.cn/blog/posts/2026/03/19-2/", "title": "\u5f53 AI \u5f00\u59cb\"\u5706\u684c\u8ba8\u8bba\"\uff1a\u4e00\u6b21\u4ee3\u7801\u51b3\u7b56\u7684\u65b0\u4f53\u9a8c", "content_html": "\u8bb0\u5f55\u4e00\u6b21\u4f7f\u7528 multi-expert skill \u8fdb\u884c\u4ee3\u7801\u8bbe\u8ba1\u8bc4\u5ba1\u7684\u5b9e\u6218\u7ecf\u5386\uff0c\u5c55\u793a\u591a\u89d2\u8272\u534f\u4f5c\u5982\u4f55\u5e2e\u52a9\u505a\u51fa\u66f4\u597d\u7684\u6280\u672f\u51b3\u7b56\u3002", "image": "https://cloaks.cn/assets/images/social/blog/posts/2026/03/19-2.png", "date_modified": "2026-09-09T09:25:33+00:00", "date_published": "2026-03-19T00:00:00+00:00", "authors": [{"name": "Cloaks"}], "tags": ["AI Agent", "Go", "Golang \u7f16\u7a0b\u5b9e\u8df5", "multi-expert", "\u4ee3\u7801\u8bc4\u5ba1", "\u9ad8\u7ea7\u67b6\u6784\u5e08"]}]}